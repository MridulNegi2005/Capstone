  ;; =====================================================================
  ;; TEXT ANNOTATIONS — Circuit Description
  ;; =====================================================================

  (text "BRAILLIX MUSCLE BOARD v1.0\nPer-cell controller: ATmega328P-AU + ULN2003A\n\nPIN ASSIGNMENTS:\n  PD4-PD7 (pins 4-7) -> ULN2003 IN1-IN4 (motor coils)\n  PC0/A0 -> Hall sensor signal (active LOW, 10K pull-up)\n  PC4/A4 -> SDA (I2C slave)\n  PC5/A5 -> SCL (I2C slave)\n  PB0-PB2 (pins 8-10) -> Address jumpers A0-A2 (internal pull-up)\n  PB3/MOSI, PB4/MISO, PB5/SCK -> ICSP programming\n\nI2C ADDRESS: 0x20-0x27 via solder jumpers\nI2C PULL-UPS: 4.7K on SDA/SCL via solder jumpers (enable on last cell only)\nMOTOR: 28BYJ-48 via 5-pin JST XH\nPOWER: 5V from pogo chain, 100uF bulk cap for motor spikes\nPROTECTION: SS14 Schottky for reverse polarity"
    (exclude_from_sim no)
    (at 20.32 180.34 0)
    (effects (font (size 1.5 1.5)) (justify left))
    (uuid "99000001-0001-0001-0001-000000000001")
  )

  ;; =====================================================================
  ;; NOTE: This schematic defines all components and their footprints.
  ;; Wiring (nets) should be completed in KiCad's schematic editor by
  ;; connecting pins according to the pin assignments above.
  ;;
  ;; Key connections to make:
